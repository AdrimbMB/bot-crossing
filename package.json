{
  "name": "bot-crossing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 3D colony sim where every coding-agent thread on your machine is a little astronaut building something.",
  "license": "MIT",
  "author": "Jarren Rocks",
  "homepage": "https://botcrossing.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarrenrocks/bot-crossing.git"
  },
  "bugs": {
    "url": "https://github.com/jarrenrocks/bot-crossing/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "desktop:icons": "node desktop/build-icons.mjs",
    "desktop": "npm run build && electron desktop/main.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "rcedit": "^4.0.1",
    "vite": "^7.1.0"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.stationsciences.agentcity",
    "productName": "AgentCity",
    "artifactName": "AgentCity-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "server/**/*",
      "package.json",
      "!data/**/*",
      "!**/*.test.mjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "AgentCity",
      "signAndEditExecutable": false
    },
    "afterPack": "desktop/after-pack.cjs",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AgentCity",
      "uninstallDisplayName": "AgentCity",
      "packElevateHelper": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
