{
  "name": "bot-crossing",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "An independent desktop fork of Bot Crossing that turns local coding-agent threads into a 3D colony.",
  "license": "MIT",
  "author": {
    "name": "Adrian Martin",
    "url": "https://github.com/AdrimbMB"
  },
  "contributors": [
    {
      "name": "Jarren Rocks",
      "url": "https://jarren.rocks"
    }
  ],
  "copyright": "Copyright © 2026 Jarren Rocks and AgentCity contributors",
  "homepage": "https://github.com/AdrimbMB/bot-crossing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdrimbMB/bot-crossing.git"
  },
  "bugs": {
    "url": "https://github.com/AdrimbMB/bot-crossing/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "npm test && npm run build && npm audit --audit-level=high",
    "desktop:icons": "node desktop/build-icons.mjs",
    "desktop": "npm run build && electron desktop/main.mjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:installer": "npm run build && electron-builder --win nsis",
    "desktop:installer:signed": "npm run build && electron-builder --config desktop/electron-builder.signed.cjs --win nsis && powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File desktop/verify-signatures.ps1",
    "desktop:store": "npm run desktop:icons && npm run build && electron-builder --config desktop/electron-builder.store.cjs --win appx --x64"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "rcedit": "^4.0.1",
    "sharp": "^0.35.4",
    "vite": "^7.3.6"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "io.github.adrimbmb.agentcity",
    "productName": "AgentCity",
    "artifactName": "AgentCity-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "toolsets": {
      "winCodeSign": "1.1.0",
      "nsis": "1.2.1"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "server/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md",
      "PRIVACY.md",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "!data/**/*",
      "!**/*.test.mjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "AgentCity",
      "signAndEditExecutable": false
    },
    "afterPack": "desktop/after-pack.cjs",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AgentCity",
      "uninstallDisplayName": "AgentCity",
      "packElevateHelper": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
